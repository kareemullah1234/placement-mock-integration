# ═══════════════════════════════════════════════════════════════════════════
# INTEGRATED APP ENV — Copy this to .env and fill in secret values
# ═══════════════════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-use-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ── Database (MySQL) ──────────────────────────────────────────────────────
DB_ENGINE=mysql
DB_NAME=placement_db
DB_USER=appuser
DB_PASSWORD=strongpassword123
DB_HOST=db                  # service name in docker-compose
DB_PORT=3306

# ── HDFS ──────────────────────────────────────────────────────────────────
HDFS_HOST=namenode          # service name in docker-compose
HDFS_PORT=9870
HDFS_USER=hdfs

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092   # internal container name
KAFKA_FRAME_TOPIC=interview-frames
KAFKA_VIDEO_TOPIC=interview-videos
KAFKA_TIMEOUT=10

# ── AI APIs ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-r1-0528
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Speech-to-Text (local Whisper) ────────────────────────────────────────
STT_PROVIDER=faster_whisper
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1
WHISPER_LANGUAGE=en

# ── Voice Interview ────────────────────────────────────────────────────────
VOICE_INTERVIEW_TTS_ENABLED=True

# ── Flask Audio API internal URL (used by Django to call Flask) ────────────
AUDIO_API_BASE_URL=http://audio_api:5000
